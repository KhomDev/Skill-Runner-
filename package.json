{
  "name": "khomdev-skill-runner",
  "version": "0.1.0",
  "description": "Skill Runner for the KhomDev audit workspace: discover SKILLS/ collections (Pashov, Trail of Bits, Web3 Bounty Hunting + dynamic others), pick a protocol from PROTOCOLS/, compose a contract-safe run prompt, and dispatch it to a DSH session.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}